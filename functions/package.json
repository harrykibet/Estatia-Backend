{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf lib",
    "build": "npm run clean && tsc",
    "build:watch": "tsc --watch",
    "test:unit": "node --test test/unit/container.test.cjs test/unit/errors.test.cjs test/unit/secret-access-policy.test.cjs",
    "test": "npm run build && npm run test:unit && npm run test:runtime",
    "test:emulator": "node --test test/emulator/validate-user.test.cjs test/emulator/get-secret.test.cjs",
    "serve": "npm run build && firebase emulators:start --only functions --project demo-estatia-ci",
    "shell": "npm run build && firebase functions:shell --project demo-estatia-ci",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:runtime": "node --test test/runtime/firebase-admin-database.test.cjs"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/secret-manager": "^6.3.0",
    "axios": "^1.19.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.1.6"
  },
  "private": true,
  "overrides": {
    "@firebase/database-compat": "2.1.6"
  }
}
