{
  "name": "functions",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf lib",
    "build": "npm run clean && tsc",
    "build:watch": "tsc --watch",
    "test:unit": "node --test test/unit/container.test.cjs test/unit/errors.test.cjs test/unit/secret-access-policy.test.cjs test/unit/profile-policy.test.cjs test/unit/property-like-policy.test.cjs test/unit/property-interaction-policy.test.cjs",
    "test": "npm run build && npm run test:unit && npm run test:runtime",
    "test:emulator": "node --test test/emulator/validate-user.test.cjs test/emulator/get-secret.test.cjs test/emulator/sync-user-profile.test.cjs test/emulator/set-property-like.test.cjs test/emulator/property-interactions.test.cjs",
    "serve": "npm run build && firebase emulators:start --only functions,auth,firestore --project demo-estatia-ci",
    "shell": "npm run build && firebase functions:shell --project demo-estatia-ci",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:runtime": "node --test test/runtime/firebase-admin-database.test.cjs"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/secret-manager": "^8.0.0",
    "axios": "^1.21.1",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.16.0",
    "eslint-config-google": "^0.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "rimraf": "^6.1.4",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.74.0"
  },
  "private": true,
  "overrides": {
    "@firebase/database-compat": "2.1.6"
  }
}
